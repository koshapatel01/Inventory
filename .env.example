# Postgres connection string — required. Attach a Postgres database to this
# project in Vercel (Storage tab -> Create Database), which auto-populates
# this in your Vercel project's env vars; copy the same value here for local
# dev (or run `vercel env pull .env.local`). This replaced local-file storage
# (data/store.json) because Vercel's serverless functions have a read-only
# filesystem. After setting this, run `npm run db:migrate` once to create the
# schema, then `npm run db:import` once to bring in any existing data/store.json.
DATABASE_URL=

# Smartsheet REST API credentials
# Token: Smartsheet → account icon → Personal Settings → API Access → Generate new access token
SMARTSHEET_API_TOKEN=your_api_token_here

# Sheet ID: open the inventory sheet → File → Properties → Sheet ID
SMARTSHEET_SHEET_ID=your_sheet_id_here

# Optional: pin the audit-log sheet (Order/Transfer/Receipt history) instead of
# letting the app auto-create one on first use. Leave unset to auto-create
# (recommended for first-time setup) — the app will create a sheet named
# "Supply Inventory — Order & Transaction Log" and remember its ID locally.
SMARTSHEET_LOG_SHEET_ID=
